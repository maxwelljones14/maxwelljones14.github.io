rules_version = '2';

// Foosball ladder. Everything is publicly readable; only verified @andrew.cmu.edu
// Google accounts can write. Elo is never stored -- the page replays confirmed
// games -- so these rules only need to keep the game list honest:
//   * a player can report a game they were in, but it starts out pending;
//   * only the *other* player can confirm (or reject) it;
//   * the admin can add already-confirmed games and fix anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function isCmu() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@andrew[.]cmu[.]edu');
    }

    function isAdmin() {
      return isCmu() && request.auth.token.email == 'mjones2@andrew.cmu.edu';
    }

    function playerExists(uid) {
      return exists(/databases/$(database)/documents/players/$(uid));
    }

    // ---- players --------------------------------------------------------

    function validProfile(d) {
      return d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60
        && d.nickname is string && d.nickname.size() <= 40
        && d.strengths is string && d.strengths.size() <= 1000
        && d.weaknesses is string && d.weaknesses.size() <= 1000
        && d.photo is string && d.photo.size() <= 200000
        && (d.photo == '' || d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }

    match /players/{uid} {
      allow read: if true;

      allow create: if isCmu()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'nickname', 'photo', 'strengths', 'weaknesses', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && validProfile(request.resource.data);

      allow update: if (isCmu() && request.auth.uid == uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['displayName', 'nickname', 'photo', 'strengths', 'weaknesses'])
        && validProfile(request.resource.data);

      allow delete: if isAdmin();
    }

    // ---- games ----------------------------------------------------------

    function validScore(s) {
      return s is int && s >= 0 && s <= 99;
    }

    // Shape shared by every stored game, whoever wrote it.
    function validGame(d) {
      return d.keys().hasOnly(['playerA', 'playerB', 'winner', 'scoreA', 'scoreB', 'status',
                               'reportedBy', 'playedAt', 'confirmedAt', 'byAdmin'])
        && d.keys().hasAll(['playerA', 'playerB', 'winner', 'scoreA', 'scoreB', 'status',
                            'reportedBy', 'playedAt', 'confirmedAt', 'byAdmin'])
        && d.playerA is string && d.playerB is string && d.playerA != d.playerB
        && (d.winner == d.playerA || d.winner == d.playerB)
        && playerExists(d.playerA) && playerExists(d.playerB)
        && d.status in ['pending', 'confirmed', 'rejected']
        && d.reportedBy is string
        && d.playedAt is timestamp
        && (d.confirmedAt == null || d.confirmedAt is timestamp)
        && d.byAdmin is bool
        // The score is optional, but if given it must be complete and agree with the winner.
        && ((d.scoreA == null && d.scoreB == null)
            || (validScore(d.scoreA) && validScore(d.scoreB)
                && ((d.winner == d.playerA && d.scoreA > d.scoreB)
                    || (d.winner == d.playerB && d.scoreB > d.scoreA))));
    }

    match /games/{gameId} {
      allow read: if true;

      allow create: if isAdmin()
        && validGame(request.resource.data)
        && request.resource.data.reportedBy == request.auth.uid;

      // A player reporting their own game: always pending, stamped with server time.
      allow create: if isCmu()
        && validGame(request.resource.data)
        && request.resource.data.reportedBy == request.auth.uid
        && request.auth.uid in [request.resource.data.playerA, request.resource.data.playerB]
        && request.resource.data.status == 'pending'
        && request.resource.data.playedAt == request.time
        && request.resource.data.confirmedAt == null
        && request.resource.data.byAdmin == false;

      // The opponent confirms or rejects; nothing else about the game can change.
      allow update: if isCmu()
        && resource.data.status == 'pending'
        && request.auth.uid in [resource.data.playerA, resource.data.playerB]
        && request.auth.uid != resource.data.reportedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt'])
        && ((request.resource.data.status == 'confirmed'
             && request.resource.data.confirmedAt == request.time)
            || (request.resource.data.status == 'rejected'
                && request.resource.data.confirmedAt == null));

      allow update: if isAdmin() && validGame(request.resource.data);

      // The reporter can withdraw a game that never counted; the admin can delete anything.
      allow delete: if isAdmin()
        || (isCmu() && resource.data.reportedBy == request.auth.uid
            && resource.data.status != 'confirmed');
    }
  }
}
