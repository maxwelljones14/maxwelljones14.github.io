{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}

{% comment %}
  Only advertise .webp variants for formats jekyll-imagemagick is actually
  configured to convert. `.gif` is commented out of site.imagemagick.input_formats
  (animated GIFs don't survive the conversion), so emitting a <source> for one
  points the browser at files that were never generated -- a guaranteed 404 that
  only the onerror fallback rescues.
{% endcomment %}
{% assign img_ext = include.path | split: '.' | last | prepend: '.' | downcase %}
{% assign responsive_ok = false %}
{% if site.imagemagick.enabled and site.imagemagick.input_formats contains img_ext %}
  {% assign responsive_ok = true %}
{% endif %}

<figure
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
>
  <picture>
    <!-- Auto scaling with imagemagick -->
    <!--
      See https://www.debugbear.com/blog/responsive-images#w-descriptors-and-the-sizes-attribute and
      https://developer.mozilla.org/en-US/docs/Learn/HTML/Multimedia_and_embedding/Responsive_images for info on defining 'sizes' for responsive images
    -->
    {% if responsive_ok %}
      <source
        class="responsive-img-srcset"
        srcset="{% for i in site.imagemagick.widths %}{{ img_path | relative_url }}-{{ i }}.webp {{i}}w,{% endfor %}"
        {% if include.sizes %}
          sizes="{{include.sizes}}"
        {% else %}
          sizes="95vw"
        {% endif %}
        type="image/webp"
      >
    {% endif %}
    <img
      src="{% if include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% else %}
        width="100%"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% else %}
        height="auto"
      {% endif %}
      {% if include['min-width'] or include['min-height'] or include['max-width'] or include['max-height'] %}
        style="
          {% if include['min-width'] %}
            min-width: {{ include.min-width }};
          {% endif %}
          {% if include['min-height'] %}
            min-height: {{ include.min-height }};
          {% endif %}
          {% if include['max-width'] %}
            max-width: {{ include.max-width }};
          {% endif %}
          {% if include['max-height'] %}
            max-height: {{ include.max-height }};
          {% endif %}
        "
      {% endif %}
      {% if include.alt %}
        alt="{{ include.alt }}"
      {% endif %}
      {% if include.title %}
        title="{{ include.title }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      {% comment %}
        Fall back to the original image when the generated .webp variants are
        missing. Vanilla JS on purpose: this is an inline attribute, so it can
        fire while the page is still parsing -- long before the jQuery tag near
        the end of <body> has run. The jQuery version threw "$ is not defined"
        once per broken image and then never removed the dead <source>, so the
        fallback silently didn't work either.
      {% endcomment %}
      onerror="this.onerror=null; var p=this.parentNode; if(p){var s=p.querySelectorAll('source.responsive-img-srcset'); for(var i=0;i<s.length;i++){s[i].parentNode.removeChild(s[i]);} } this.src=this.src;"
    >
  </picture>

  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
